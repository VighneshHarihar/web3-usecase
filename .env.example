# ── Core ─────────────────────────────────────────────
NODE_ENV=development
PORT=8080
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://postgres@127.0.0.1:5432/loyalink
# Generate with: openssl rand -hex 32
SESSION_SECRET=dev-session-secret-change-me
CUSTOMER_REF_SECRET=dev-customer-ref-secret-change-me

# ── Login (OTP over SMS) ─────────────────────────────
# Shows the OTP on screen. NEVER enable in production.
OTP_DEV_ECHO=true
SMS_PROVIDER=console            # console | webhook
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Comma-separated E.164 numbers that become admins on login
ADMIN_PHONES=+919999900000

# ── Payments (UPI) ───────────────────────────────────
PAYMENTS_PROVIDER=sandbox       # sandbox | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Chain (the quiet witness) ────────────────────────
CHAIN_MODE=off                  # off | local | rpc
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CHAIN_NAME=Local dev chain
EXPLORER_URL=                   # e.g. https://sepolia.basescan.org
# Hardhat test key #0 by default. Set a real key for testnet/production.
#OPERATOR_PRIVATE_KEY=
ESCROW_ADDRESS=
TOKEN_ADDRESS=
FEE_BPS=200
